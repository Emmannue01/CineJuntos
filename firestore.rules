rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isFriend(uidA, uidB) {
      return uidA == uidB || exists(/databases/$(database)/documents/friendships/$(uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA));
    }
    function ownsUsername(username) {
      return existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }
    function isListMember(listId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/watchlists/$(listId)).data.memberUids;
    }
    function isRoomMember(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
    }
    function isRoomMemberOrInvited(roomId) {
      return signedIn() && (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids || request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.invitedUids);
    }
    function isRoomInvited(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.invitedUids;
    }
    function isRoomOwner(roomId) {
      return signedIn() && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid;
    }
    function isRoomOwnerOrMember(roomId) {
      return signedIn() && (isRoomOwner(roomId) || isRoomMember(roomId));
    }
    function isRoomOwnerOrMemberOrInvited(roomId) {
      return signedIn() && (isRoomOwner(roomId) || isRoomMember(roomId) || isRoomInvited(roomId));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.username == request.resource.data.usernameLower
        && ownsUsername(request.resource.data.usernameLower)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'displayName', 'photoURL', 'avatar', 'bio', 'createdAt', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$')
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined'])
        || (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'declined'
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt'])
          && request.resource.data.status == 'pending')
      );
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.memberUids
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids[0] < request.resource.data.memberUids[1]
        && friendshipId == request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1]
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending';
      allow delete: if false;
      allow update: if false;
    }

    match /watchlists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() in [1, 2]
        && request.auth.uid in request.resource.data.memberUids
        && (request.resource.data.memberUids.size() == 1 || isFriend(request.auth.uid, request.resource.data.memberUids[0]) && isFriend(request.auth.uid, request.resource.data.memberUids[1]));
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /videos/{videoId} {
        allow read: if isListMember(listId);
        allow create: if isListMember(listId) && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.status in ['pending', 'watched'];
        allow update: if isListMember(listId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'position', 'title', 'thumbnail', 'videoId']);
        allow delete: if isListMember(listId);
      }
    }

    match /rooms/{roomId} {
      allow read: if isRoomMemberOrInvited(roomId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isRoomOwnerOrMemberOrInvited(roomId);
      allow delete: if false;
    }

    match /roomInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && inviteId == request.resource.data.roomId + '_' + request.resource.data.toUid;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }
  }
}
