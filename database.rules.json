{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
        "members": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "state": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['updatedAt', 'updatedBy']) && newData.child('updatedBy').val() === auth.uid && newData.child('updatedAt').isNumber()"
        },
        "chat": {
          "$messageId": {
            ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
            ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'username', 'avatar', 'text', 'createdAt', 'kind']) && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('kind').val().matches(/^(message|reaction)$/)"
          }
        },
        "voice": {
          "$callerUid": {
            ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
            ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          }
        },
        "queue": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
        },
        "queueUpdatedBy": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && newData.val() === auth.uid"
        }
      }
    }
  }
}
